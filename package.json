{
  "name": "ons-agendahulp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --test",
    "check": "node scripts/check.mjs && node scripts/check-imports.mjs && node scripts/deps.mjs --strict",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-force-exit test/*.test.js",
    "dev": "node scripts/build.mjs --watch",
    "release": "node scripts/release.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.25.12",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.5.0"
  }
}

{
  "manifest_version": 3,
  "name": "ONS Agendahulp",
  "version": "1.6.189",
  "description": "Afspraak-/registratiehulp en gekleurde dagindeling voor ONS Agenda.",
  "permissions": ["storage"],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ONS Agendahulp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://impegno.ons-dossier.nl/*",
    "https://*.onsagenda.nl/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": [
        "https://*.onsagenda.nl/*",
        "https://impegno.ons-dossier.nl/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://impegno.ons-dossier.nl/*"
      ],
      "js": ["survey-required.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.onsagenda.nl/*",
        "https://impegno.ons-dossier.nl/*"
      ],
      "js": ["modules.js", "dist/react-bundle.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.onsagenda.nl/*",
        "https://impegno.ons-dossier.nl/*"
      ],
      "js": ["mainworld.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ioservice.net/*"
      ],
      "js": ["io-planning-block.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
